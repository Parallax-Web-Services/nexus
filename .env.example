APP_NAME=NEXUS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Exact post-logout pages of your OAuth applications, comma-separated.
OAUTH_LOGOUT_RETURN_URLS=

# Optional existing service integrations; leave blank for a standalone installation.
DOMAIN_POSITRONIC=
DOMAIN_PLEXUS=
DOMAIN_PERPETUITY=
DOMAIN_TALOS=
DOMAIN_SLIPSTREAM=

URL_POSITRONIC=
URL_PLEXUS=
URL_PERPETUITY=
URL_TALOS=
URL_SLIPSTREAM=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite uses database/database.sqlite by default. Create that file before migrating.
# DB_DATABASE=/absolute/path/to/database.sqlite
# For MySQL, set DB_CONNECTION=mysql and configure the following values:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nexus
# DB_USERNAME=nexus
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

# Additional Stripe accounts as key:Name, comma-separated, e.g. "acme:Acme Inc".
# Each reads <KEY>_STRIPE_SECRET and <KEY>_STRIPE_WEBHOOK_SECRET (e.g. ACME_STRIPE_SECRET).
BILLING_ACCOUNTS=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Council checkout (optional); webhook signing secret is endpoint-specific.
COUNCIL_LIVEMODE=false
COUNCIL_STRIPE_WEBHOOK_SECRET=
COUNCIL_STRIPE_ACCOUNT_ID=
COUNCIL_STRIPE_PORTAL_CONFIGURATION=
COUNCIL_PUBLIC_URLS=
COUNCIL_CONTINUUM_URL=
COUNCIL_CONTINUUM_CALLBACK=
COUNCIL_BOARDROOM_CALLBACK=
